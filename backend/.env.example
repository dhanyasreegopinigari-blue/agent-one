ENV=development
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=^https://agent-one-[a-z0-9-]+\.vercel\.app$

AUTH_DISABLED=true            # local dev only; MUST be false in production
SUPABASE_URL=
SUPABASE_JWT_SECRET=          # leave empty to verify via JWKS (asymmetric signing keys)

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
ALLOW_GEMINI_FALLBACK=true

WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=
